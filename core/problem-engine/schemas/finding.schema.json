{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devkit.local/schemas/finding.schema.json",
  "title": "DEVKIT Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "record_type", "schema_version", "title", "description", "severity", "confidence", "status", "evidence_ids", "affected_paths"],
  "properties": {
    "id": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "record_type": { "const": "finding" },
    "schema_version": { "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "type": "string", "enum": ["candidate", "suspected", "verified", "accepted", "resolved", "false_positive", "wont_fix"] },
    "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true, "maxItems": 100 },
    "affected_paths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "maxItems": 500 },
    "domain": { "type": "string", "minLength": 1, "maxLength": 100 },
    "recommendations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 50 },
    "related_finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "maxItems": 100 }
  }
}
