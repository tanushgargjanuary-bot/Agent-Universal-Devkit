{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanushgargjanuary-bot/Agent-Universal-Devkit/blob/main/core/orchestrator/task.schema.json",
  "title": "Agent Universal Devkit Orchestration Task",
  "type": "object",
  "required": [
    "task_id",
    "goal",
    "repository",
    "tasks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "required": [
        "full_name",
        "default_branch"
      ],
      "properties": {
        "full_name": {
          "type": "string"
        },
        "default_branch": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred_harness": {
            "type": [
              "string",
              "null"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "planned",
              "blocked",
              "ready",
              "running",
              "passed",
              "failed",
              "cancelled"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "target"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "policy": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "technology_decision": {
      "type": "object",
      "required": [
        "schema_version",
        "repository",
        "inspection",
        "workload",
        "decision",
        "ranked_candidates",
        "approval",
        "status",
        "warnings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "repository": {
          "type": "string"
        },
        "inspection": {
          "type": "object"
        },
        "workload": {
          "type": "object"
        },
        "decision": {
          "enum": [
            "single_stack",
            "polyglot_hybrid",
            "insufficient_evidence"
          ]
        },
        "recommendation": {
          "type": [
            "object",
            "null"
          ]
        },
        "ranked_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "required",
            "approved",
            "reason"
          ]
        },
        "status": {
          "enum": [
            "provisional",
            "proposal_only"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
